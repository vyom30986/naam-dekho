# ── Core ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Postgres ───────────────────────────────────────────────────
# Local development default. Choose your own password for anything shared.
DATABASE_URL=postgres://naamdekho:naamdekho_dev_password@localhost:5432/naamdekho

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────
# Generate your own. Never reuse a value from an example file.
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── OTP via MSG91 (India SMS) ──────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=NAAMDK

# ── Razorpay (primary payment gateway) ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Paytm (fallback payment gateway) ───────────────────────────
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL_ID=WEB

# ── Object storage (R2 / S3, for PDFs) ─────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=naamdekho-reports

# ── Optional connector API keys ────────────────────────────────
GODADDY_API_KEY=
GODADDY_API_SECRET=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_KEY=
TWO_CAPTCHA_KEY=
GITHUB_TOKEN=

# ── Frontend origin (CORS) ─────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173,https://naamdekho.in,https://www.naamdekho.in
